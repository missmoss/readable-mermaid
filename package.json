{
  "name": "readable-mermaid",
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "description": "Local-first custom renderer for Mermaid sequenceDiagram, optimized for readability and designed for AI agent calls.",
  "homepage": "https://github.com/missmoss/readable-mermaid#readme",
  "bugs": {
    "url": "https://github.com/missmoss/readable-mermaid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/missmoss/readable-mermaid.git"
  },
  "files": [
    "src",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "mermaid",
    "cli",
    "sequence-diagram",
    "diagram",
    "svg",
    "png",
    "local-first",
    "readability", 
    "ai-tools"
  ],
  "bin": {
    "readable-mermaid": "./src/cli.js"
  },
  "scripts": {
    "start": "node ./src/cli.js",
    "test:sample": "node ./src/cli.js ./samples/run-job-sequence.mmd",
    "test": "node --test",
    "test:regression": "node ./scripts/check-sample-artifacts.js",
    "samples:refresh": "node ./scripts/render-sample-artifacts.js",
    "release:licenses": "node ./scripts/generate-license-inventory.js",
    "release:checksums": "node ./scripts/generate-checksums.js",
    "release:artifacts": "node ./scripts/prepare-release-artifacts.js",
    "release:sbom": "npm sbom --omit=dev --sbom-format=cyclonedx",
    "deps:prod": "npm ls --omit=dev --depth=0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "puppeteer-core": "24.9.0"
  }
}
